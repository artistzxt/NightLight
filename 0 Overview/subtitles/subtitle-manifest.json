{
  "cues": [
    {
      "cue_sha256": "bd8fa44a1657a2581117ce91e49cb856af300b0e0a72648183e746461f1f7f29",
      "end_ms": 2770,
      "id": "cue-000001-bd8fa44a1657",
      "original_index": "1",
      "position": 1,
      "settings": "",
      "start_ms": 80,
      "text": "Let's begin our exploration of the AI",
      "text_sha256": "9811f522d1d64ce53afaabdfd555af37e1e4e08337fec823b332df0718fb8940",
      "timing_line": "00:00:00,080 --> 00:00:02,770"
    },
    {
      "cue_sha256": "e7f1ff74eed41e7bfe74042030f07122382b6414083d68c709aec41261aa63db",
      "end_ms": 6839,
      "id": "cue-000002-e7f1ff74eed4",
      "original_index": "2",
      "position": 2,
      "settings": "",
      "start_ms": 2000,
      "text": "fluency",
      "text_sha256": "129df964b701d0b8e72fe7224cc71643cf8e000d122e72f742747708f5e3bb62",
      "timing_line": "00:00:02,000 --> 00:00:06,839"
    },
    {
      "cue_sha256": "3d547bce0792db6f4d106eb9fbe53cc5e6be42a3ce1b16afc6dbc26cc7a17b78",
      "end_ms": 12300,
      "id": "cue-000004-3d547bce0792",
      "original_index": "4",
      "position": 4,
      "settings": "",
      "start_ms": 6839,
      "text": "framework. I'm Joe Feller. My name is",
      "text_sha256": "fd7e807019aee3c1f90e205e397f618beb04482adc7b2c947da326205a940436",
      "timing_line": "00:00:06,839 --> 00:00:12,300"
    },
    {
      "cue_sha256": "5cde89d2605ebc66f7fc3716c0108e27e6b2bfd2ef4cf84fa56fc6463e90884a",
      "end_ms": 16760,
      "id": "cue-000005-5cde89d2605e",
      "original_index": "5",
      "position": 5,
      "settings": "",
      "start_ms": 9280,
      "text": "Drew. I'm Maggie Vo. My name is Rick",
      "text_sha256": "3ec5d6d8a3175db74079471fc206a63bac54c74f01e1716d0e0fe0504887c45b",
      "timing_line": "00:00:09,280 --> 00:00:16,760"
    },
    {
      "cue_sha256": "8124ed67fb15909f35e4b3d01694b979ad04312acf48fd05988c43b26e161284",
      "end_ms": 21600,
      "id": "cue-000007-8124ed67fb15",
      "original_index": "7",
      "position": 7,
      "settings": "",
      "start_ms": 16760,
      "text": "Dacon. The focus of this course is not",
      "text_sha256": "769b6157fa73baaeb328b369c7d02428577798309303b9ab82fc73c772afd98d",
      "timing_line": "00:00:16,760 --> 00:00:21,600"
    },
    {
      "cue_sha256": "37daf9c2ef5a20e2e1b35929c8544ec171152a0da6c2614cbb6fd873d6a0a05a",
      "end_ms": 23840,
      "id": "cue-000008-37daf9c2ef5a",
      "original_index": "8",
      "position": 8,
      "settings": "",
      "start_ms": 19520,
      "text": "really about AI as a technology.",
      "text_sha256": "49d3cf13ea6ac710ae30f5db2e83f7a12479c7b19b72a929bcda29f5cb673e93",
      "timing_line": "00:00:19,520 --> 00:00:23,840"
    },
    {
      "cue_sha256": "f9e44cc9bb97f910ba08546326bbcab15a15006170030be713e09165e8e517fe",
      "end_ms": 25600,
      "id": "cue-000009-f9e44cc9bb97",
      "original_index": "9",
      "position": 9,
      "settings": "",
      "start_ms": 21600,
      "text": "Instead, it's mostly about you and I, us",
      "text_sha256": "ca8d319eb4b2672dc2221c19f1baf52fed2df21568613bb028157781dc51042f",
      "timing_line": "00:00:21,600 --> 00:00:25,600"
    },
    {
      "cue_sha256": "17c86e1376f9249cd3188c6d452706f8719a97040f562b0621d4106982642bf0",
      "end_ms": 28400,
      "id": "cue-000010-17c86e1376f9",
      "original_index": "10",
      "position": 10,
      "settings": "",
      "start_ms": 23840,
      "text": "humans, and how we interact and",
      "text_sha256": "c94c7eda2b19c31800ea9118cd426375e589d3b51c0833364c347759b811fbe5",
      "timing_line": "00:00:23,840 --> 00:00:28,400"
    },
    {
      "cue_sha256": "218f5f5c3e719a4889b7a56d5301a706e5525aef7427aba79beaee50c176328e",
      "end_ms": 30560,
      "id": "cue-000011-218f5f5c3e71",
      "original_index": "11",
      "position": 11,
      "settings": "",
      "start_ms": 25600,
      "text": "collaborate with AI systems. We explore",
      "text_sha256": "a68722c6cd83a567020f91f0932415db2e61bd7458eea9c2c2f8dcd3e02b1cd8",
      "timing_line": "00:00:25,600 --> 00:00:30,560"
    },
    {
      "cue_sha256": "f844d419d7edcba4118f412b7f7688fbe26b232f420027c62bdd6a0199a82470",
      "end_ms": 32559,
      "id": "cue-000012-f844d419d7ed",
      "original_index": "12",
      "position": 12,
      "settings": "",
      "start_ms": 28400,
      "text": "AI fluency, our ability to engage with",
      "text_sha256": "ff500fdb82bd02ff1f76715a841da1872f13a8f3bf6f9fdc361d33eeec42721d",
      "timing_line": "00:00:28,400 --> 00:00:32,559"
    },
    {
      "cue_sha256": "8ab64a45bf58714a3eadbf5461025ca323195b9fd600023a3dae00d1b5b4b80d",
      "end_ms": 35440,
      "id": "cue-000013-8ab64a45bf58",
      "original_index": "13",
      "position": 13,
      "settings": "",
      "start_ms": 30560,
      "text": "AI systems in ways that are effective,",
      "text_sha256": "1ee10bc16fb24321c26d66db15dc491c0f35713033ee9aa52113cc35cf8c4a51",
      "timing_line": "00:00:30,560 --> 00:00:35,440"
    },
    {
      "cue_sha256": "9aeeab87867b694031abe1097af501e0c5f87a08fadd05bfafe6e214d1aa15de",
      "end_ms": 37600,
      "id": "cue-000014-9aeeab87867b",
      "original_index": "14",
      "position": 14,
      "settings": "",
      "start_ms": 32559,
      "text": "efficient, ethical, and safe. It's about",
      "text_sha256": "9269841a7b8208b08bd200182af864bc4650e68bfb6359ecc492d292837742c7",
      "timing_line": "00:00:32,559 --> 00:00:37,600"
    },
    {
      "cue_sha256": "4562284dc3a99e82ad2911d733f42451e69c43580f0103551a524ce0f1b517bc",
      "end_ms": 40079,
      "id": "cue-000015-4562284dc3a9",
      "original_index": "15",
      "position": 15,
      "settings": "",
      "start_ms": 35440,
      "text": "imagining possibilities that don't treat",
      "text_sha256": "fe3890c5de8a73f960550df3137128d56d2265417399ca65e906c736355dce21",
      "timing_line": "00:00:35,440 --> 00:00:40,079"
    },
    {
      "cue_sha256": "fd965b8248105542842413a8f2d1738694a8e2df7bd142f254bab31a576a69bc",
      "end_ms": 41920,
      "id": "cue-000016-fd965b824810",
      "original_index": "16",
      "position": 16,
      "settings": "",
      "start_ms": 37600,
      "text": "AI as some sort of next level spellch",
      "text_sha256": "920ef3bc0deebcdd8a1b76fdae68c889ea5f288bbc2f3e169d164d9a184583c8",
      "timing_line": "00:00:37,600 --> 00:00:41,920"
    },
    {
      "cue_sha256": "6988cbfafd4686d9b3f29cae39645ff2334eb48257b1b284f17a1175cd11706d",
      "end_ms": 43760,
      "id": "cue-000017-6988cbfafd46",
      "original_index": "17",
      "position": 17,
      "settings": "",
      "start_ms": 40079,
      "text": "checker, but instead as a trusted",
      "text_sha256": "8d1ac69f8bae60bb4c1de25f378ff5d8a45505069d6258845b848492ad1e77c0",
      "timing_line": "00:00:40,079 --> 00:00:43,760"
    },
    {
      "cue_sha256": "5e60678a9b730af33ed9a811269d2728b3ec786e995c3577e6275ab09d7a38cb",
      "end_ms": 46320,
      "id": "cue-000018-5e60678a9b73",
      "original_index": "18",
      "position": 18,
      "settings": "",
      "start_ms": 41920,
      "text": "partner for doing creative and",
      "text_sha256": "7353d8273311dab42b37b4a342a4fa676b1ed129c6bff06b735dc01406ee649e",
      "timing_line": "00:00:41,920 --> 00:00:46,320"
    },
    {
      "cue_sha256": "ece3bed30dda8d4f45a2258719e67dc65f31292327e06a3053128c4210e79cb0",
      "end_ms": 48399,
      "id": "cue-000019-ece3bed30dda",
      "original_index": "19",
      "position": 19,
      "settings": "",
      "start_ms": 43760,
      "text": "innovative problem solving work. This",
      "text_sha256": "4cf79e7f2edcb365a830fd3caaa8d1f072be578018eb4c618aec1d48c4ba594e",
      "timing_line": "00:00:43,760 --> 00:00:48,399"
    },
    {
      "cue_sha256": "f6b48daea4f5568c407276d4e249428f019da3242e14be2d5d4857a7d0c7de30",
      "end_ms": 50800,
      "id": "cue-000020-f6b48daea4f5",
      "original_index": "20",
      "position": 20,
      "settings": "",
      "start_ms": 46320,
      "text": "will help you develop an intuitive feel",
      "text_sha256": "106c63ea00cd966b249c906b4e26d1d0191f0cd8e9e77af51aac98de2d52d2dd",
      "timing_line": "00:00:46,320 --> 00:00:50,800"
    },
    {
      "cue_sha256": "f545f0790f9d78d99e49fab015601fa115fd460177359fb0c884058845e846ca",
      "end_ms": 52800,
      "id": "cue-000021-f545f0790f9d",
      "original_index": "21",
      "position": 21,
      "settings": "",
      "start_ms": 48399,
      "text": "for what generative AI can do and how",
      "text_sha256": "ff67a87b1e739b8aefedb5112816f8128c5f2ba7dd8caa13987f7be7ea9b2f57",
      "timing_line": "00:00:48,399 --> 00:00:52,800"
    },
    {
      "cue_sha256": "80449d2b79800a8d3f36fd4b2c56a11840c365cff0ffa309991f844c77ccf909",
      "end_ms": 54800,
      "id": "cue-000022-80449d2b7980",
      "original_index": "22",
      "position": 22,
      "settings": "",
      "start_ms": 50800,
      "text": "best to work with it. We're all learning",
      "text_sha256": "cbc93985f97f4f000af89ebbd16ca81f235999254db6f872dbe9b7dafc182464",
      "timing_line": "00:00:50,800 --> 00:00:54,800"
    },
    {
      "cue_sha256": "e2ba660603151c36b777bc9427deef678f398b5b7614485bfcfa1ccb9a5fb21c",
      "end_ms": 57600,
      "id": "cue-000023-e2ba66060315",
      "original_index": "23",
      "position": 23,
      "settings": "",
      "start_ms": 52800,
      "text": "together how to navigate this rapidly",
      "text_sha256": "5205b5e658c339f6308918e3f1af1b0f5432ad4a47558d9b3b0aac20bab381cb",
      "timing_line": "00:00:52,800 --> 00:00:57,600"
    },
    {
      "cue_sha256": "d854c44b6a8ac9feee7dc5553b7808998fb2e1f8e7b5c04382f01d60b9c66f64",
      "end_ms": 60000,
      "id": "cue-000024-d854c44b6a8a",
      "original_index": "24",
      "position": 24,
      "settings": "",
      "start_ms": 54800,
      "text": "evolving landscape. This course is about",
      "text_sha256": "2c6cda42bc88bea62355ca223145888939f3346ebd011601a0c429b0ba2f04fc",
      "timing_line": "00:00:54,800 --> 00:01:00,000"
    },
    {
      "cue_sha256": "a686346dc68fe76c47eab14f2cd9d511c952b4715e8060822cff0208c1a07a34",
      "end_ms": 63000,
      "id": "cue-000025-a686346dc68f",
      "original_index": "25",
      "position": 25,
      "settings": "",
      "start_ms": 57600,
      "text": "fundamentally shifting how we approach",
      "text_sha256": "f95c5250c57df7b6233e543f1b0996f2776877cc639634c56385e67ee6b6cc34",
      "timing_line": "00:00:57,600 --> 00:01:03,000"
    },
    {
      "cue_sha256": "57ed99f0fb585f3d45edb90e6059c56499db3cfc051b69faef492f0a9aaef7ba",
      "end_ms": 63000,
      "id": "cue-000026-57ed99f0fb58",
      "original_index": "26",
      "position": 26,
      "settings": "",
      "start_ms": 60000,
      "text": "AI.",
      "text_sha256": "da8e5b3c13f6473c6d366132273be5040eb882fb6a42618d75da028d9dc42b1e",
      "timing_line": "00:01:00,000 --> 00:01:03,000"
    }
  ],
